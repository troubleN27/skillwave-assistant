# Neon PostgreSQL: pooled connection string (host contains "-pooler")
DATABASE_URL=
# Neon direct (unpooled) connection string, used for migrations. Optional.
DATABASE_URL_UNPOOLED=

# Gemini API key from Google AI Studio
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Better Auth: random secret (at least 32 characters) and the public app URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob (uploaded knowledge base files)
BLOB_READ_WRITE_TOKEN=

# Telegram notifications about new leads
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public site URL (links in notifications, widget embed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
